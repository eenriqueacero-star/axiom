# Render static-site headers.
# Hashed build assets never change — cache them hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell, the service worker and the manifest must always revalidate so a
# new deploy actually reaches installed PWAs instead of serving a stale bundle.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
