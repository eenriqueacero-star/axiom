# Groq API keys (up to 5 for key rotation)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Finnhub
FINNHUB_KEY=

# Firebase Admin SDK — either paste the whole service-account JSON here...
FIREBASE_SERVICE_ACCOUNT=
# ...or supply the three fields individually
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web API key (for client auth verification fallback)
FIREBASE_WEB_API_KEY=

# Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Client URL (for CORS)
CLIENT_URL=https://your-app.vercel.app
